# basic arithmetic
1 + 1                       => 2
1 + 1 + 1                   => 3
1 - 1                       => 0
1 - 5                       => -4
5 * 5                       => 25
5 / 5                       => 1
5 / 2                       => 2.5
5 % 2                       => 1
6 % 2                       => 0
2 ^ 8                       => 256
1.2 + 2.5                   => 3.7

# operator word aliases
6 mod 2                     => 0
6 modulo 2                  => 0
5 mul 5                     => 25
5 * 5 mul 10                => 250
5 * (5 mul 10 + 1)          => 255
5 div 5                     => 1
100 div 10 / 2              => 5
2 pow 8                     => 256
2 power 8                   => 256

# precedence
1 + 2 * 4                   => 9
(1 + 2) * 4                 => 12
((1 + 2) * 4) / 2           => 6
(1 + 2) * 4 / 2             => 6

# whitespace does not matter
1+1                         => 2
(1+1)/2                     => 1
((1+1)/2)*2                 => 2

# unary minus/plus
-1                          => -1
-1 + -1                     => -2
-1 - 1                      => -2
-1 + - 1                    => -2
--(2^8)                     => 256
-(150 * 2 / 2 + 1)          => -151
--++ ++ ++++++ - -123 + 1   => 124

# implicit multiplication
2(1+5)                      => 12
2 (1 + 5)                   => 12
2^2(1+5)                    => 24
2 ^ 2 (1 + 5)               => 24
(1+5)2                      => 12
( 1 + 5 ) 2                 => 12
( 1 + 5 ) 2^2               => 24
( 1 + 5 ) (1+1+1+1)         => 24

# functions
min(1, 5)                   => 1
max(1, 5)                   => 5
max(min(1, 10),max(1, 5))   => 5

# number bases
0xFF                        => 255
0xFF + 10 + 0xA             => 275
0o777                       => 511
0b10                        => 2
0b1111                      => 15
0b1111 * 0xF + 0o777 - 36   => 700

# output formats
256 to hex                  => 0x100
256 to binary               => 0b100000000

# bitwise
1 << 8                      => 256
1 << 16                     => 65536
256 >> 1                    => 128
256 >> 2                    => 64

# percentages
20% of 100                  => 20
20% of 100 * 2              => 40
(20% of 100) * 2            => 40
(10 + 10)% of 100 + 2       => 22
40% of 10^2                 => 40

# constants
pi                          => 3.14159

# thousand separators
1_000_000 + 1_000           => 1001000
