# equality
42 == 42                    => true
42 == 21 * 2                => true
2^8==256                    => true
-5 == -5                    => true
1.5 == 1.5                  => true
42 == 21                    => false
2^8==255                    => false
-5 == 5                     => false

# inequality
42 != 21                    => true
2^8 != 255                  => true
-5 != 5                     => true
42 != 42                    => false
42 != 21 * 2                => false

# greater than, strict vs non-strict at the boundary
42 > 21                     => true
21 > 42                     => false
42 > 42                     => false
0 > -1                      => true
1.5 > 1.4                   => true
42 >= 21                    => true
42 >= 42                    => true
21 >= 42                    => false
-1 >= 1                     => false
-1 >= 0                     => false

# less than, strict vs non-strict at the boundary
21 < 42                     => true
42 < 21                     => false
42 < 42                     => false
-2 < -1                     => true
-1 < 0                      => true
1.4 < 1.5                   => true
21 <= 42                    => true
42 <= 42                    => true
42 <= 21                    => false
0 <= -1                     => false

# comparison binds looser than arithmetic
1 + 1 == 2                  => true
2 * 3 > 4 + 1               => true
2 * 3 > 5 + 0               => true
10 - 5 <= 2 + 3             => true
2^3 < 3^2                   => true
10 % 3 != 10 / 5            => true

# units convert implicitly before comparing
1 km == 1000 m              => true
1 km != 999 m               => true
1 km > 999 m                => true
1 km >= 1000 m              => true
1 km < 1001 m               => true
1 km <= 1000 m              => true
30min < 1hour               => true
2 hours <= 60 min           => false

# dates compare chronologically
18/01/2001 == 18/01/2001    => true
18/01/2001 != 19/01/2001    => true
18/01/2001 < 19/01/2001     => true
18/01/2001 <= 18/01/2001    => true
19/01/2001 > 18/01/2001     => true
19/01/2001 >= 18/01/2001    => true
19/01/2001 < 18/01/2001     => false
