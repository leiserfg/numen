# ambiguous numeric date resolves day-first (DD/MM/YYYY)
11/08/2025                  => 2025-08-11 00:00:00 (Etc/UTC)

# slashes with spaces around them are division, not a date
2001 / 1 / 18               => 111.167

# 'm' means minutes when converting to seconds, not meters
1m to s                     => 60s

# 'pounds' is mass or gbp depending on the conversion target
100 pounds to kg            => 45.3592kg
1 pounds to usd             => !error No conversion rate available between gbp and usd.

# exact alias wins before prefix decomposition: min is never milli-inch,
# mi is mile (not mebi), mb stays megabyte (not millibit)
1 min to s                  => 60s
1 mi to km                  => 1.60934km
1 mb to b                   => 1000000b

# a token that is a unit by itself is never reinterpreted as a plural:
# ms is milliseconds, not meters; mins is minutes, not milli-inches
5 ms to s                   => 0.005s
5 mins to s                 => 300s

# prefix case matters where symbols collide: m is milli, M is mega
1 mm to m                   => 0.001m
1 Mm to km                  => 1000km

# 'in' is a conversion operator between units, a unit name elsewhere
1m in in                    => 39.3701in

# adjacent digit + constant is implicit multiplication
2pi                         => 6.28319
pi2                         => 6.28319
