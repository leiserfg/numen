# length
1 km to m                   => 1000m
1 km in m                   => 1000m
km to in                    => 39370.07874in
5 feet to cm                => 152.4cm
3 miles to km               => 4.828032km

# prefix and plural expansion
1 kilometres to m           => 1000m
10 kms to m                 => 10000m
5KM to m                    => 5000m
1000 micrograms to mg       => 1mg
2 dl to ml                  => 200ml

# mass
80 kg to lbs                => 176.36981lbs
1 tonne to kg               => 1000kg
1 pound to kg               => 0.453592kg

# duration
1m to s                     => 60s
2 weeks to days             => 14days
5 ms to s                   => 0.005s
3 microseconds to ms        => 0.003ms

# temperature
100 f to c                  => 37.777778c
20 c to f                   => 68f
0 c to k                    => 273.15k

# data
1 gb to mb                  => 1000mb
1 GB to MB                  => 1000MB
1 kib to b                  => 1024b
1 gib to mib                => 1024mib

# volume
2 cups to ml                => 473.176473ml

# area
1 acre to sqm               => 4046.856422sqm

# speed
100 mph to kmh              => 160.9344kmh
90 kmh to mph               => 55.923407mph

# implicit conversion in binary expressions
30min + 1hour               => 1 hr 30 min

# currency: identity and same-currency arithmetic work without rates
100 dollars                 => 100dollars
100 usd + 20 usd            => 120usd

# units flowing through functions
max(1 km to m, 100)         => 1000m

# like over like cancels, leaving a plain number
1 km / 100 m                => 10
100 usd / 4 usd             => 25
1 hour / 30 min             => 2
1 kg / 500 g                => 2
1 km / 1 km                 => 1

# a unit survives being scaled by a plain number
1 km / 2                    => 0.5km
1 km * 2                    => 2km
2 * 1 km                    => 2km
1 km + 100 m                => 1100m

# but there is no way to name a squared or reciprocal unit yet, so those are
# refused rather than labelled with one of the operands
1 km * 1 km                 => !error Cannot multiply two units
1 usd * 1 usd               => !error Cannot multiply two units
1 km * 100 m                => !error Cannot multiply two units
2 / 1 km                    => !error Cannot divide by a unit
1 / 1 s                     => !error Cannot divide by a unit

# raising to anything but 0 or 1 has the same problem
2 m ^ 2                     => !error Cannot raise a unit to that power
2 m ^ 0.5                   => !error Cannot raise a unit to that power
2 m ^ 1                     => 2m
2 m ^ 0                     => 1
