# length
1 km to m                   => 1,000m
1 km in m                   => 1,000m
km to in                    => 39,370.07874in
5 feet to cm                => 152.4cm
3 miles to km               => 4.828032km

# prefix and plural expansion
1 kilometres to m           => 1,000m
10 kms to m                 => 10,000m
5KM to m                    => 5,000m
1000 micrograms to mg       => 1mg
2 dl to ml                  => 200ml

# mass
80 kg to lbs                => 176.36981lbs
1 tonne to kg               => 1,000kg
1 pound to kg               => 0.453592kg

# multiplied constants usage with units
1pi km                      => 3.141593km
pi1 km                      => 3.141593km

# duration
1m to s                     => 60s
2 weeks to days             => 14days
5 ms to s                   => 0.005s
3 microseconds to ms        => 0.003ms

# temperature
100 f to c                  => 37.777778c
20 c to f                   => 68f
0 c to k                    => 273.15k

# data
1 gb to mb                  => 1,000mb
1 GB to MB                  => 1,000MB
1 kib to b                  => 1,024b
1 gib to mib                => 1,024mib

# volume
2 cups to ml                => 473.176473ml

# area
1 acre to sqm               => 4,046.856422m²

# speed
100 mph to kmh              => 160.9344km/h
90 kmh to mph               => 55.923407mi/h

# implicit conversion in binary expressions
30min + 1hour               => 1 hr 30 min

# currency: identity and same-currency arithmetic work without rates
100 dollars                 => 100dollars
100 usd + 20 usd            => 120usd

# units flowing through functions
max(1 km to m, 100)         => 1,000m

# like over like cancels, leaving a plain number
1 km / 100 m                => 10
100 usd / 4 usd             => 25
1 hour / 30 min             => 2
1 kg / 500 g                => 2
1 km / 1 km                 => 1

# a unit survives being scaled by a plain number
1 km / 2                    => 0.5km
1 km * 2                    => 2km
2 * 1 km                    => 2km

# when two operands share a dimension the larger unit wins, so the result reads
# the way the bigger of the two was typed, whichever side it was on
1 km + 100 m                => 1.1km
100 m + 1 km                => 1.1km
1 kg + 500 g                => 1.5kg
500 g + 1 kg                => 1.5kg

# multiplying or dividing composes a new unit
1 km * 1 km                 => 1km²
1 km * 100 m                => 0.1km²
100 m * 1 km                => 0.1km²
100 km / 2 hr               => 50km/hr
2 / 1 km                    => 2/km
1 / 1 s                     => 1/s
10 m * 2 s                  => 20m·s
100 usd / 4 hr              => 25usd/hr

# exponents add, so a unit over itself cancels back to a plain number
1 km * 1 km / 1 km          => 1km
100 km / 2 hr * 2 hr        => 100km

# powers multiply the exponents
2 m ^ 2                     => 4m²
2 m ^ 3                     => 8m³
2 m ^ 1                     => 2m
2 m ^ 0                     => 1

# a fractional power would need a root of the dimension, which has no meaning
2 m ^ 0.5                   => !error Cannot raise a unit to that power

# a conversion target may be composed too, and agrees with the named unit
100 mph to km/hr            => 160.9344km/hr
100 km / 2 hr to mph        => 31.06856mi/h
50 m / 1 s to km/hr         => 180km/hr
1 km/hr to m/s              => 0.277778m/s
1 km * 1 km to sqkm         => 1km²
1 sqkm to km*km             => 1km²
1 acre to m*m               => 4,046.856422m²

# only a real unit may follow the operator, so these still apply to the result
1 km to m / 2               => 500m
1 km to m * 2               => 2,000m

# the dimensions still have to match
1 km to km/hr               => !error Incompatible units: km to km/hr

# a rate is just another factor, but the same currency on both sides cancels
# before any rate is needed. these run without a provider, hence the error
100 usd / 2 hr to usd/hr    => 50usd/hr
100 usd / 2 hr to eur/hr    => !error No conversion rate available for eur.

# money divides into other things to give a rate, and that is all it does
100 usd / 2 hr              => 50usd/hr
2 / 1 usd                   => 2/usd
100 usd / 2 usd             => 50
50 usd / 1 hr * 8 hr        => 400usd

1 usd * 1 usd               => !error usd can only be combined with other units as a rate
2 usd ^ 2                   => !error usd can only be combined with other units as a rate
1 usd * 2 kg                => !error usd can only be combined with other units as a rate

# an affine unit is a point on a scale, so it has no square or reciprocal
20 c * 3 m                  => !error Cannot build a compound unit out of celsius
2 c ^ 2                     => !error Cannot build a compound unit out of celsius
1 / 1 c                     => !error Cannot build a compound unit out of celsius

# a composed unit renders its name rather than carrying one the table knows, so
# adding two of them must not go looking for "km/h" in the unit list
150km/h + 100km/h           => 250km/h
150km/h - 50km/h            => 100km/h
150km/h > 100km/h           => true
1 m*m + 1 m*m               => 2m²
1 usd/hr + 1 usd/hr         => 2usd/hr

# the larger unit still wins, and the dimensions still have to match
150km/h + 10m/s             => 51.666667m/s
10m/s + 150km/h             => 51.666667m/s
1 km/h + 1 kg               => !error Incompatible units: km/h to kg

# places shadow units: "gb" (Great Britain) is a legacy tzdb link, "acre" and
# "mile" are towns. after a conversion operator the unit is meant
1 tb to gb                  => 1,000gb
500 mb to gb                => 0.5gb
1 sqm to acre               => 0.000247acre
1 ha to acre                => 2.471054acre
1 acre to m*m to acre       => 1acre
5 km to mile                => 3.106856mile

# function arguments are computed independently, so min/max used to compare the
# bare numbers and answer that 1 km was smaller than 999 m
min(1 km, 999 m)            => 0.999km
max(1 km, 999 m)            => 1km
min(1 hr, 30 min)           => 0.5hr
max(2 kg, 500 g)            => 2kg
min(5 m/s, 10 km/h)         => 2.777778m/s
min(20 c, 50 f)             => 10c
min(1 km, 1 hr)             => !error Incompatible units: hr to km

# a plain number among the arguments means they are not all comparable
max(1 km to m, 100)         => 1,000m

# a named compound is its composition, so it behaves identically however it was
# spelled. "60 kmh * 2 hr" used to give 120kmh·hr because kmh was atomic and
# had no hour term for the hour to cancel against
60 kmh * 2 hr               => 120km
60 km/h * 2 hr              => 120km
1 sqm / 1 m                 => 1m
1 m*m / 1 m                 => 1m
1 sqm * 1 m                 => 1m³
1 kmh + 1 km/h              => 2km/h
1 mph * 2 hr                => 2mi
2 mps * 3 s                 => 6m

# so does the promotion of a bare target against a composed source
150 kmh to in               => 5,905,511.811024in/h
150 km/h to in              => 5,905,511.811024in/h

# the composition is what gets displayed, aliases are only spellings
1 kmh                       => 1km/h
1 sqm                       => 1m²
1 sqkm                      => 1km²
1 mph                       => 1mi/h

# units that are not products of anything we have stay atomic, and still
# convert against the composed form
1 hectare to m*m            => 10,000m²
1 knot to m/s               => 0.514444m/s
1 acre                      => 1acre

# dimensions are unchanged by the rewrite
1 kmh to mph                => 0.621371mi/h
1 sqkm to hectare           => 100hectare
1 kmh * 1 kmh               => 1km²/h²

# unit-preserving functions
abs(-3 m)                   => 3m
abs(1 km to m)              => 1,000m
floor(2.7 km)               => 2km
ceil(2.1 kg)                => 3kg
round(2.567 km, 1)          => 2.6km
trunc(-2.7 hr)              => -2 hr
sign(-5 m)                  => -1
sum(1 km, 500 m)            => 1.5km
sum(1 hr, 30 min)           => 1.5hr
avg(1 km, 3 km)             => 2km
avg(20 c, 30 c)             => 25c
hypot(3 m, 4 m)             => 5m
hypot(3 km, 4000 m)         => 5km
max(100, 1 km to m)         => 1,000m
sum(1 km, 1 hr)             => !error Incompatible units: hr to km

# no roots or logarithms of dimensions
sqrt(4 m)                   => !error sqrt: argument 1 must be a plain number, got 4 m
sqrt(1 km to m)             => !error sqrt: argument 1 must be a plain number, got 1,000 m
ln(2 kg)                    => !error
pow(2 m, 2)                 => !error

# a unit can follow a call like any other term
sqrt(4) km                  => 2km
sqrt(4)m                    => 2m
2 * sqrt(4) km              => 4km
sqrt(4) km to m             => 2,000m
sqrt(4) km + 1              => 3km

# square/cubic
5km2                        => 5km²
5km3                        => 5km³
